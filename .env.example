# =============================================================
# GAMING SHOP - ENVIRONMENT SOZLAMALARI (NAMUNA)
# =============================================================
# Bu faylni nusxalab, nomini ".env" ga o'zgartiring va real
# qiymatlaringizni kiriting:
#
#   Windows (PowerShell yoki CMD):
#       copy .env.example .env
#
# Keyin .env faylini ochib, quyidagi qiymatlarni to'ldiring.
# .env fayli hech qachon Git'ga yuklanmaydi (.gitignore'da bor).
# =============================================================

# Telegram bot tokeni. @BotFather orqali /newbot bilan olinadi.
BOT_TOKEN=8974160432:AAFLv3hfi--YL-8kAvlWQwYOBtUr4rsfSbM

# Admin(lar)ning Telegram ID raqamlari, vergul bilan ajratiladi.
# O'z Telegram ID'ingizni @userinfobot orqali bilib olishingiz mumkin.
ADMIN_TELEGRAM_IDS=5825531272

# Balans to'ldirish so'rovlari va yangi buyurtmalar tushadigan
# Telegram kanal/guruh ID'si (bot shu kanalda admin bo'lishi kerak).
# Bu 2-bosqichda ishlatiladi.
ADMIN_CHANNEL_ID=-1003860341740

# To'lov uchun karta ma'lumotlari (foydalanuvchiga ko'rsatiladi).
# Bu 2-bosqichda ishlatiladi.
PAYMENT_CARD_NUMBER=9860 1666 5622 7914
PAYMENT_CARD_NAME=Abdokimov Zoxidjon

# Har bir yangi referral uchun beriladigan bonus (so'mda).
# Bu 8-bosqichda ishlatiladi.
REFERRAL_REWARD=1000

# Telegram Mini App sessiyalarini imzolash uchun maxfiy kalit (6-bosqich).
# Istalgan uzun, tasodifiy qator bo'lishi mumkin - lekin uni HECH KIMGA
# bermang va boshqa loyihalarda qayta ishlatmang.
# Masalan, quyidagi Python buyrug'i bilan tasodifiy qator yarata olasiz:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=LUCIFER_GAMING_SHOP_2026_9f7Kx82mQp4Zt6Rv1Ns8Hd3Y

# Saytingizning ochiq (public) manzili - Telegram botidagi "🌐 Saytni
# ochish" tugmasi shu yerga olib boradi va uni Mini App sifatida ochadi.
# MUHIM: Telegram faqat HTTPS manzillarni qabul qiladi - localhost yoki
# http:// ISHLAMAYDI. Mahalliy rivojlantirishda sinash uchun ngrok kabi
# vosita bilan vaqtinchalik HTTPS havola oling (README'dagi 6-bosqich
# qismiga qarang). Bo'sh qoldirilsa, bot bu tugmani ko'rsatmaydi.
WEBSITE_URL=POST /api/auth/telegram

# Do'kon nomi (bot xabarlarida ko'rinadi)
SHOP_NAME=Gaming Shop

# =============================================================
# FRONTEND (React sayt) uchun sozlamalar - 5-bosqichdan boshlab
# =============================================================
# MUHIM: Vite xavfsizlik sababli faqat "VITE_" bilan boshlangan
# o'zgaruvchilarni brauzerga (frontend kodiga) ochib beradi - shuning
# uchun SHOP_NAME kabi umumiy o'zgaruvchilar frontend uchun ishlamaydi,
# alohida VITE_ prefiksli nusxasi kerak.

# Backend API qayerda ishlayotgani (odatda o'zgartirish shart emas)
VITE_API_URL=http://127.0.0.1:8000

# Saytda ko'rinadigan do'kon nomi (yuqoridagi SHOP_NAME bilan bir xil qiling)
VITE_SHOP_NAME=Ruzo Shop

# Telegram botingizning username'i (@ belgisisiz), sayt pastidagi va
# "Balans/Buyurtmalar/Profil" sahifalaridagi "Telegram botni ochish"
# tugmasi shu username'ga olib boradi.
VITE_BOT_USERNAME=ruzoshop_bot
